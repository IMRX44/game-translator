<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GameTranslator.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <!-- For the system-tray NotifyIcon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF handles DPI via the manifest; silence the WinForms-only high-DPI analyzer. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AssemblyName>GameTranslator</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameTranslator.Core\GameTranslator.Core.csproj" />
    <ProjectReference Include="..\GameTranslator.Providers\GameTranslator.Providers.csproj" />
    <ProjectReference Include="..\GameTranslator.Platform.Windows\GameTranslator.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- This is a WPF app that only uses WinForms for the tray icon. Drop the project-wide
         implicit WinForms/GDI usings so their types don't collide with WPF (Application,
         FontFamily, Point, Rectangle, KeyEventArgs, MouseEventArgs...). TrayIconManager.cs
         imports System.Drawing / System.Windows.Forms explicitly where it needs them. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the offline glossary next to the exe. -->
    <None Include="..\..\assets\glossary\fa.json" Link="assets\glossary\fa.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
