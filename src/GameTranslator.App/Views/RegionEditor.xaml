<Window x:Class="GameTranslator.App.Views.RegionEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ویرایش نواحی متن — Region editor"
        Height="640" Width="900"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Tahoma, Segoe UI"
        Background="#1E1E24" Foreground="#EDEDED">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="نام پروفایل:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="NameBox" Width="180" Background="#2A2A33" Foreground="White"/>
            <Button Content="افزودن ناحیه (بکشید)" Margin="10,0,0,0" Padding="8,4" Click="AddMode_Click"/>
            <Button Content="پاک‌کردن همه" Margin="6,0,0,0" Padding="8,4" Background="#7a3a3a" Foreground="White" Click="Clear_Click"/>
            <Button Content="بازخوانی تصویر" Margin="6,0,0,0" Padding="8,4" Click="Recapture_Click"/>
            <TextBlock x:Name="Hint" Text="" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#9AD29A"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="ذخیره پروفایل" Padding="12,5" Background="#3A6EA5" Foreground="White" Click="Save_Click"/>
            <Button Content="بستن" Padding="12,5" Margin="6,0,0,0" Background="#555" Foreground="White" Click="Close_Click"/>
            <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <Border Background="#101014">
            <Grid x:Name="ImageHost" ClipToBounds="True">
                <Image x:Name="Shot" Stretch="Uniform"/>
                <Canvas x:Name="DrawCanvas" Background="Transparent"
                        MouseLeftButtonDown="Canvas_Down"
                        MouseMove="Canvas_Move"
                        MouseLeftButtonUp="Canvas_Up"/>
            </Grid>
        </Border>
    </DockPanel>
</Window>
